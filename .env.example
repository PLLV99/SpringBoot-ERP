# Example environment variables for NextJS-ERP
# Copy this file to `.env.local` for local development.

# Where /api/* is forwarded to.
#
# Local development: next.config.ts reads this and falls back to
# http://localhost:8080 when it is unset, so you only need it if the backend
# runs somewhere else.
#
# Production: vercel.json reads the same name, and there it has no fallback -
# set it in the Vercel project settings before deploying.
BACKEND_URL=http://localhost:8080

# Nothing else is read from the environment. The API base path (/api) and the
# token key (token_erp) are constants in app/Config.ts, not settings.
